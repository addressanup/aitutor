<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LLDB attach for dev. NO App Sandbox, ever: a sandboxed process cannot hold
	     Accessibility control, post CGEvents, or capture arbitrary windows — which is
	     why the Mac App Store is impossible for this product. Hardened runtime is
	     deferred to the notarization recipe (M0 end). -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
