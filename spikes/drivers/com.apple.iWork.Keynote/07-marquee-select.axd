# name: marquee select
# reps: 3
# Rubber-band selection: a drag that starts on empty canvas rather than on an
# object. Semantically distinct from cmd+a even though the resulting selection
# often matches, and it is the mouse-side twin of that action.
activate
key esc
drag 18% 20% 72% 82%
sleep 600
key esc
drag 18% 20% 72% 82%
sleep 600
key esc
drag 18% 20% 72% 82%
