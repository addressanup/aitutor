# name: bullet list
# reps: 3
# Two returns leave the list again, so every rep starts from a plain empty line
# and performs the identical action rather than riding auto-continuation.
activate
key cmd+a
key right
key return
type - Atomic notes stay small
key return
key return
sleep 500
type - Each note earns its own title
key return
key return
sleep 500
type - Links carry the meaning
key return
key return
