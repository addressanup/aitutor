# name: save note
# reps: 3
# Obsidian autosaves, so this is the explicit "Save current file" command rather
# than a state change. If it turns out to be Silent, that is a real finding about
# a save-shaped step in a tutor script, not a broken driver.
activate
key cmd+s
sleep 600
key cmd+s
sleep 600
key cmd+s
