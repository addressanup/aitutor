# name: switch note
# reps: 3
# Ends back on Scratch, which is the note the earlier drivers edited and the one
# the remaining drivers expect to be frontmost.
activate
key cmd+o
sleep 400
type Note B
sleep 400
key return
sleep 600
key cmd+o
sleep 400
type Note C
sleep 400
key return
sleep 600
key cmd+o
sleep 400
type Scratch
sleep 400
key return
