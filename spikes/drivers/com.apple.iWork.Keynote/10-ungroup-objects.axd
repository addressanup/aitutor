# name: ungroup objects
# reps: 3
# Groups first because ungroup needs something to act on; the group is made in a
# separate burst from the ungroup so the two are not smeared into one signature.
activate
key esc
key cmd+a
key cmd+opt+g
sleep 500
key cmd+opt+shift+g
sleep 600
key cmd+a
key cmd+opt+g
sleep 500
key cmd+opt+shift+g
sleep 600
key cmd+a
key cmd+opt+g
sleep 500
key cmd+opt+shift+g
