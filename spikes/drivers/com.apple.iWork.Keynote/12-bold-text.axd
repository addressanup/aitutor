# name: bold text
# reps: 3
# Object-level formatting: with the boxes selected but not being edited, cmd+b
# restyles all their text. Each burst is an on/off pair, so the deck is unchanged.
activate
key esc
key cmd+a
sleep 300
key cmd+b
key cmd+b
sleep 600
key cmd+b
key cmd+b
sleep 600
key cmd+b
key cmd+b
