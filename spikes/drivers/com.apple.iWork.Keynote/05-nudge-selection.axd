# name: nudge selection
# reps: 3
# Each burst returns the objects to where it found them, so the fractions the
# later drivers click at stay true.
activate
key esc
key cmd+a
sleep 300
key right
key right
key down
key down
key left
key left
key up
key up
sleep 600
key right
key right
key down
key down
key left
key left
key up
key up
sleep 600
key right
key right
key down
key down
key left
key left
key up
key up
