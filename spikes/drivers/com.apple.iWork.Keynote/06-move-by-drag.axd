# name: move by drag
# reps: 3
# Out and back inside one burst: the mouse path is the action, and the object ends
# each rep where it started.
activate
key esc
drag 30% 30% 42% 22%
drag 42% 22% 30% 30%
sleep 600
drag 30% 30% 42% 22%
drag 42% 22% 30% 30%
sleep 600
drag 30% 30% 42% 22%
drag 42% 22% 30% 30%
