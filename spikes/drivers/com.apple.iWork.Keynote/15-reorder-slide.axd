# name: reorder slide
# reps: 3
# Dragging a thumbnail up the navigator, undone each time. Distinct from move by
# drag: same verb, different surface, and telling those two apart is the whole
# question the density bar is asking.
activate
click 7% 30%
sleep 400
drag 7% 30% 7% 18%
sleep 700
key cmd+z
sleep 600
drag 7% 30% 7% 18%
sleep 700
key cmd+z
sleep 600
drag 7% 30% 7% 18%
sleep 700
key cmd+z
