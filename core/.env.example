# Copy to core/.env (gitignored). No API keys are needed at scaffold —
# the ModelPort is an interface stub; nothing calls out to a vendor.

# IPC discovery. If unset, the core reads the shell's ipc.json handoff file at
# ~/Library/Application Support/TutorShell/ipc.json.
AITUTOR_IPC_URL=ws://127.0.0.1:47100/ipc
AITUTOR_IPC_TOKEN=dev-token

# debug | info | warn | error
LOG_LEVEL=debug

# When the real shell is ready, remove AITUTOR_IPC_URL/TOKEN and let discovery run.
# ANTHROPIC_API_KEY is intentionally absent until the ModelPort is implemented (M0).
